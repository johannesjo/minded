<!-- DAY phase of the living companion sun (06–19), for the sun standing on a
     background we DON'T control: the bare widget over the user's wallpaper. A
     white disc (warming to the faintest gold only at the rim) wrapped in a soft
     AMBER glow, so it announces itself as a sun on any wallpaper rather than
     reading as a pale blob.

     Its twin ic_sun_widget_day_on_sky.xml is identical but for the bloom's four
     gradient stops, which are white - that one is used wherever the app paints
     its own sky behind the sun (the prompt card), where the in-app halo rule
     applies. Keep the two in step; sunHaloMirror.test.ts asserts they only
     differ in those four stops.

     Picked by the local hour in MyAppWidget, not by the dark-mode qualifier.
     See docs/sun-halo.md and docs/sun-companion-widget.md. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:aapt="http://schemas.android.com/aapt"
        android:width="108dp"
        android:height="108dp"
        android:viewportWidth="108"
        android:viewportHeight="108">

    <!-- Soft warm glow (the sun's bloom + idle-breath halo), gentle and low-alpha -->
    <path android:pathData="M54,54 m-53,0 a53,53 0 1,0 106,0 a53,53 0 1,0 -106,0">
        <aapt:attr name="android:fillColor">
            <gradient
                    android:type="radial"
                    android:centerX="54"
                    android:centerY="54"
                    android:gradientRadius="53">
                <item android:offset="0.0" android:color="#00FFD877" />
                <item android:offset="0.56" android:color="#00FFD877" />
                <item android:offset="0.74" android:color="#47FFD673" />
                <item android:offset="1.0" android:color="#00FFCB5A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The white disc, warming to the faintest gold only at the very rim -->
    <path android:pathData="M54,54 m-36,0 a36,36 0 1,0 72,0 a36,36 0 1,0 -72,0">
        <aapt:attr name="android:fillColor">
            <gradient
                    android:type="radial"
                    android:centerX="54"
                    android:centerY="54"
                    android:gradientRadius="36">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.84" android:color="#FFFFFFFF" />
                <item android:offset="1.0" android:color="#FFFFF5DC" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
